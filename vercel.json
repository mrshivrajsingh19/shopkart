{
  "version": 2,
  "rewrites": [
    { "source": "/customers/:path*", "destination": "/api/index.js" },
    { "source": "/customers", "destination": "/api/index.js" },
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}